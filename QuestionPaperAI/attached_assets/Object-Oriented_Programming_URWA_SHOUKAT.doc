    width: 15pt;
    height: 15pt;
    border: 1.5pt solid #000;
    border-radius: 50%;
    margin-right: 5pt;
    vertical-align: middle;
  }
  
  /* Signature section */
  .signature-section {
    display: flex;
    justify-content: space-between;
    margin-top: 30pt;
    page-break-inside: avoid;
  }
  .signature-box {
    border-bottom: 1pt solid #000;
