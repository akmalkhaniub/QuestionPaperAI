    code { background-color: #f5f5f5; padding: 1px; border-radius: 2px; font-family: monospace; font-size: 9px; }
    .bubbles { display: grid; grid-template-columns: auto auto auto auto auto; gap: 2px; margin-top: 1px; font-size: 7px; }
